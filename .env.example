# Optional. When set, /api/contact sends real email through Resend.
RESEND_API_KEY=
# Where enquiries go (defaults to the studio email in src/content.ts)
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Twinpix Studio <hello@yourdomain.com>". Defaults to Resend's onboarding sender.
CONTACT_FROM_EMAIL=
# Canonical site URL for Open Graph tags
NEXT_PUBLIC_SITE_URL=
# Optional booking link (Cal.com, Calendly...). Empty hides the "Book a call" button.
NEXT_PUBLIC_BOOKING_URL=
